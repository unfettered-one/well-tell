                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" value="read-only query / doc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reads" target="db">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e8" value="rows + report text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="db" target="reads">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e9" value="evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reads" target="agent">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e10" value="if user feedback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="agent" target="writes">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e11" value="audited insert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="writes" target="db">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e12" value="echo affected view" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="writes" target="agent">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e13" value="final JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="agent" target="validate">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e14" value="verified result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="validate" target="response">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e15" value="HTTP 200 JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="response" target="render">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e16" value="follow-up; same session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="render" target="request">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="trustedTitle" value="TRUST / SAFETY CONTROLS" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="38" y="755" width="400" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="trust1" value="Identity boundary&#xa;This is a local/trusted demo, NOT authenticated. user_id is caller-supplied. Session ownership + MCP metadata bind API-created conversations, but do not defend against a malicious local process." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="35" y="800" width="420" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="trust2" value="Read boundary&#xa;query_db permits one read-only SELECT/WITH/EXPLAIN, capped at 50 rows. Private memories/messages/sessions are blocked from arbitrary SQL. Production, downtime, spill/SOP/RCA logic belongs in v_* views." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="485" y="800" width="420" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="trust3" value="Write boundary&#xa;Corrections are audited overlays; rules are explicit runtime overrides; facts are shared; claims remain unconfirmed; memories are per-user. No raw inspection row is changed. Timeout can happen after a write committed." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="935" y="800" width="420" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="trust4" value="Failure boundary&#xa;No streaming or simulated progress. 403/404/409/422/502/503/504 are surfaced; no answer is shown unless tool evidence, recall, citations and shape pass validation. Never auto-retry uncertain writes." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="1385" y="800" width="420" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="asof" value="Evaluation date = meta.as_of_&lt;dataset&gt;; never substitute wall-clock date. Run one API deployment per database. Add authentication/authorization before any public exposure." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#526579;" vertex="1" parent="1">
                    <mxGeometry x="38" y="952" width="1750" height="32" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>