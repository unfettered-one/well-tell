  <diagram id="system" name="System Architecture"><mxGraphModel dx="1900" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Well Tell | End-to-end system architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="35" y="18" width="1200" height="42" as="geometry"/></mxCell><mxCell id="subtitle" value="Implemented local/trusted demo architecture • evidence and domain calculations stay in SQLite/MCP, not the browser" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="38" y="58" width="1500" height="28" as="geometry"/></mxCell><mxCell id="h_client" value="CLIENT" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="260" height="24" as="geometry"/></mxCell><mxCell id="h_api" value="HTTP BACKEND" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="590" y="96" width="260" height="24" as="geometry"/></mxCell><mxCell id="h_agent" value="AGENT RUNTIME" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="930" y="96" width="260" height="24" as="geometry"/></mxCell><mxCell id="h_mcp" value="MCP TOOLS" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="1270" y="96" width="260" height="24" as="geometry"/></mxCell><mxCell id="h_store" value="DATA &amp; FILES" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="1580" y="9