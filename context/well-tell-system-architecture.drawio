                <mxCell id="agent" value="OpenCode copilot agent&#xa;Calls tools; follows answer/citation protocol&#xa;Uses meta.as_of_&lt;dataset&gt; as “today”&#xa;No domain arithmetic in model" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="1570" y="215" width="280" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="ui" value="React UI&#xa;Displays answer + exact source IDs&#xa;Renders typed visual specification&#xa;Never recomputes operational rules" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="1570" y="450" width="280" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="rule" value="Rule + correction precedence&#xa;Manual-derived rules seed baseline. Runtime override wins.&#xa;Latest applicable correction overlays raw value.&#xa;Both are applied by views; audit rows retained." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="700" y="855" width="700" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="ingest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="src" target="ing">
