    <diagram id="sequence" name="Chat Sequence &amp; Trust">
        <mxGraphModel dx="1900" dy="1010" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1010" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Well Tell | Chat lifecycle, writes &amp; trust boundaries" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="35" y="18" width="1500" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Synchronous chat: one complete response per request • tool calls are model-driven • uncertain write outcomes are never retried automatically" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#526579;" vertex="1" parent="1">
                    <mxGeometry x="38" y="58" width="1700" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="1 • CLIENT" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1">
                    <mxGeometry x="35" y="105" width="270" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="2 • API + SESSION GUARD" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1">
                    <mxGeometry x="335" y="105" width="270" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="3 • OPENCODE + AGENT" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1">
                    <mxGeometry x="650" y="105" width="270" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c4" value="4 • MCP TOOLS" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1">
                    <mxGeometry x="965" y="105" width="270" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c5" value="5 • DATA SOURCES" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1">
                    <mxGeometry x="1280" y="105" width="270" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c6" value="6 • VALIDATED RESPONSE" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1">
                    <mxGeometry x="1590" y="105" width="270" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="request" value="Browser / React UI&#xa;POST /chat&#xa;user_id • dataset_id&#xa;session_id • question" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="35" y="155" width="245" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="api" value="FastAPI request gate&#xa;Pydantic bounds + dataset loaded&#xa;owner/dataset match • no concurrent turn&#xa;log user turn" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="335" y="155" width="260" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="mapping" value="Persistent conversation map&#xa;frontend chat ID → OpenCode session ID&#xa;user_id + dataset_id + busy_until&#xa;SQLite backend_conversations" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="335" y="335" width="260" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="bridge" value="OpenCode bridge&#xa;Create/reuse V2 session&#xa;Inject trusted context server-side&#xa;Prompt → wait → read this turn" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="650" y="155" width="260" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="agent" value="Copilot agent + model&#xa;System rules + selected provider model&#xa;Calls Well MCP (must recall first)&#xa;Produces answer + citations + visual JSON" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="650" y="335" width="260" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="mcp" value="MCP server over stdio&#xa;--require-session checks OpenCode metadata&#xa;Binds tool calls to API-owned user/dataset&#xa;Reads and writes are explicit tools" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="965" y="155" width="260" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="reads" value="Evidence retrieval&#xa;`v_*` views for domain conclusions&#xa;recall(user + well) • describe/query_db&#xa;get_doc / get_report when needed" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="965" y="335" width="260" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="db" value="SQLite + dataset files&#xa;Read-only raw path • derived views&#xa;Cataloged manuals/SOPs/reports&#xa;Runtime facts, memories, corrections, rules" style="shape=cylinder3;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="1280" y="155" width="260" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="writes" value="Optional feedback write path&#xa;record_correction: stored value is wrong&#xa;set_rule: threshold changes&#xa;remember: fact / claim / private memory&#xa;Raw rows remain untouched; views reapply" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="1280" y="335" width="260" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="validate" value="Fail-closed bridge validation&#xa;Successful Well MCP evidence + recall required&#xa;Citations must occur in tool results&#xa;Answer + visual schema validated" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="650" y="565" width="260" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="response" value="FastAPI response&#xa;{session_id, answer, citations, visual, tool_calls}&#xa;Log assistant turn • release session lock&#xa;502/504 on upstream or validation failure" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="335" y="565" width="260" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="render" value="Frontend validation + rendering&#xa;Zod contract • Markdown (HTML off)&#xa;Exact citation chips + six typed visuals&#xa;Accessible pending/error states" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#243447;" vertex="1" parent="1">
                    <mxGeometry x="35" y="565" width="245" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="JSON request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="request" target="api">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="authorize / reserve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="mapping">
                    <mxGeometry relative="1" as="geometry"/>
