  <diagram id="data" name="Data &amp; Ingestion"><mxGraphModel dx="1900" dy="1040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Well Tell | Data architecture &amp; ingestion" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="35" y="18" width="1200" height="42" as="geometry"/></mxCell><mxCell id="subtitle" value="One SQLite file • dataset-scoped ingested rows • shared/private runtime knowledge • domain math is centralized in SQL views" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="38" y="58" width="1500" height="28" as="geometry"/></mxCell><mxCell id="hsrc" value="SOURCE FILES" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="35" y="100" width="280" height="24" as="geometry"/></mxCell><mxCell id="hingest" value="INGEST + VERIFY" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="280" height="24" as="geometry"/></mxCell><mxCell id="hdb" value="SQLITE DATA LAYERS" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="280" height="24" as="geometry"/></mxCell><mxCell id="hmcp" value="MCP ACCESS" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="1120" y="100" width="280" height="24" as="geometry"/></mxCell><mxCell id="hanswer" value="ANSWER CONSUMERS" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="1570" y="100" width="280" height="24" as="geometry"/></mxCell><mxCell id="src" value="Dataset root&#xa;Fleet: areas/users + manuals/SOPs&#xa;Per-well metadata + inspections&#xa;Maintenance • events • context notes&#xa;Maintenance report Markdown" style="shape=folder;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#8c9bab;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="35" y="180" width="255" height="175" as="geometry"/></mxCell><mxCell id="ing" value="ingest/ingest.py&#xa;Dataset-scoped replace transaction&#xa;Parse JSON/JSONL • extract report facts&#xa;Catalog docs • parse rules • build indexes" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="340" y="180" width="275" height="155" as="geometry"/></mxCell><mxCell id="verify" value="ingest/verify.py&#xa;Schema/counts • orphan checks&#xa;Report path/extraction coverage&#xa;Rule checks + sample golden gates" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="340" y="395" width="275" height="135" as="geometry"/></mxCell><mxCell id="raw" value="RAW INGESTED TABLES&#xa;Keyed by (dataset_id, id)&#xa;teams • areas • users • wells • equipment&#xa;inspections • maintenance • events&#xa;context_notes • documents • rules&#xa;report_facts" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="320" height="195" as="geometry"/></mxCell><mxCell id="views" value="DERIVED `v_*` VIEWS • READ PATH&#xa;Effective inspections (latest valid correction)&#xa;Production • downtime • spills/classification&#xa;SOP obligations • corrective repairs/RCA&#xa;Conflicts • repair costs&#xa;Views join rules + corrections at query time" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="700" y="390" width="320" height="185" as="geometry"/></mxCell><mxCell id="runtime" value="RUNTIME KNOWLEDGE + CONVERSATION&#xa;corrections • shared facts • unconfirmed claims&#xa;private memories • sessions/messages&#xa;backend_conversations + owner/dataset mapping&#xa;rule overrides (per loaded dataset)&#xa;Raw ingested records are never updated" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="700" y="635" width="320" height="170" as="geometry"/></mxCell><mxCell id="read" value="Read tools&#xa;query_db (one read-only SELECT/WITH/EXPLAIN)&#xa;list_tables • describe • recall&#xa;get_doc • get_report" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="1120" y="175" width="280" height="145" as="geometry"/></mxCell><mxCell id="writes" value="Write tools&#xa;record_correction • remember • set_rule&#xa;log_message for standalone MCP clients&#xa;Main API logs both chat turns directly&#xa;Audited runtime writes; verify + echo" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="1120" y="450" width="280" height="130" as="geometry"/></mxCell><mxCell id="files" value="Document/report resolver&#xa;SQL catalog + dataset_root_&lt;id&gt;&#xa;get_doc: manual/SOP path&#xa;get_report: maintenance_id → report_file&#xa;No hand-built report paths" style="shape=folder;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#8c9bab;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="1120" y="665" width="280" height="140" as="geometry"/></mxCell><mxCell id="agent" value="OpenCode copilot agent&#xa;Calls tools; follows answer/citation protocol&#xa;Uses meta.as_of_&lt;dataset&gt; as “today”&#xa;No domain arithmetic in model" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="1570" y="215" width="280" height="140" as="geometry"/></mxCell><mxCell id="ui" value="React UI&#xa;Displays answer + exact source IDs&#xa;Renders typed visual specification&#xa;Never recomputes operational rules" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="1570" y="450" width="280" height="130" as="geometry"/></mxCell><mxCell id="rule" value="Rule + correction precedence&#xa;Manual-derived rules seed baseline. Runtime override wins.&#xa;Latest applicable correction overlays raw value.&#xa;Both are applied by views; audit rows retained." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="700" y="855" width="700" height="75" as="geometry"/></mxCell><mxCell id="e1" value="ingest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="src" target="ing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="build then gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ing" target="verify"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="publish valid dataset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="verify" target="raw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="rules + corrections" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="raw" target="views"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="read-time overlay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="runtime" target="views"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="read via query_db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="views" target="read"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="evidence + citations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="read" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="answer + visual JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="agent" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="feedback through chat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ui" target="writes"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="insert / log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="writes" target="runtime"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="catalog IDs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="read" target="files"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="document text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="files" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="private identity-bound writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="runtime" target="writes"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="footer" value="Dataset rows carry dataset_id and are replaced independently (sample + test coexist). Runtime tables are not dataset-scoped except rule overrides written for each loaded dataset. Query results are capped; private tables are denied to arbitrary SQL." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="38" y="950" width="1780" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram>
  <diagram id="sequence" name="Chat Sequence &amp; Trust"><mxGraphModel dx="1900" dy="1010" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Well Tell | Chat lifecycle, writes &amp; trust boundaries" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="35" y="18" width="1500" height="42" as="geometry"/></mxCell><mxCell id="subtitle" value="Synchronous chat: one complete response per request • tool calls are model-driven • uncertain write outcomes are never retried automatically" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="38" y="58" width="1700" height="28" as="geometry"/></mxCell><mxCell id="c1" value="1 • CLIENT" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="35" y="105" width="270" height="24" as="geometry"/></mxCell><mxCell id="c2" value="2 • API + SESSION GUARD" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="335" y="105" width="270" height="24" as="geometry"/></mxCell><mxCell id="c3" value="3 • OPENCODE + AGENT" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="650" y="105" width="270" height="24" as="geometry"/></mxCell><mxCell id="c4" value="4 • MCP TOOLS" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="965" y="105" width="270" height="24" as="geometry"/></mxCell><mxCell id="c5" value="5 • DATA SOURCES" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="1280" y="105" width="270" height="24" as="geometry"/></mxCell><mxCell id="c6" value="6 • VALIDATED RESPONSE" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="1590" y="105" width="270" height="24" as="geometry"/></mxCell><mxCell id="request" value="Browser / React UI&#xa;POST /chat&#xa;user_id • dataset_id&#xa;session_id • question" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="35" y="155" width="245" height="120" as="geometry"/></mxCell><mxCell id="api" value="FastAPI request gate&#xa;Pydantic bounds + dataset loaded&#xa;owner/dataset match • no concurrent turn&#xa;log user turn" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="335" y="155" width="260" height="135" as="geometry"/></mxCell><mxCell id="mapping" value="Persistent conversation map&#xa;frontend chat ID → OpenCode session ID&#xa;user_id + dataset_id + busy_until&#xa;SQLite backend_conversations" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="335" y="335" width="260" height="130" as="geometry"/></mxCell><mxCell id="bridge" value="OpenCode bridge&#xa;Create/reuse V2 session&#xa;Inject trusted context server-side&#xa;Prompt → wait → read this turn" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="650" y="155" width="260" height="135" as="geometry"/></mxCell><mxCell id="agent" value="Copilot agent + model&#xa;System rules + selected provider model&#xa;Calls Well MCP (must recall first)&#xa;Produces answer + citations + visual JSON" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="650" y="335" width="260" height="140" as="geometry"/></mxCell><mxCell id="mcp" value="MCP server over stdio&#xa;--require-session checks OpenCode metadata&#xa;Binds tool calls to API-owned user/dataset&#xa;Reads and writes are explicit tools" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="965" y="155" width="260" height="135" as="geometry"/></mxCell><mxCell id="reads" value="Evidence retrieval&#xa;`v_*` views for domain conclusions&#xa;recall(user + well) • describe/query_db&#xa;get_doc / get_report when needed" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="965" y="335" width="260" height="130" as="geometry"/></mxCell><mxCell id="db" value="SQLite + dataset files&#xa;Read-only raw path • derived views&#xa;Cataloged manuals/SOPs/reports&#xa;Runtime facts, memories, corrections, rules" style="shape=cylinder3;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="1280" y="155" width="260" height="135" as="geometry"/></mxCell><mxCell id="writes" value="Optional feedback write path&#xa;record_correction: stored value is wrong&#xa;set_rule: threshold changes&#xa;remember: fact / claim / private memory&#xa;Raw rows remain untouched; views reapply" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="1280" y="335" width="260" height="155" as="geometry"/></mxCell><mxCell id="validate" value="Fail-closed bridge validation&#xa;Successful Well MCP evidence + recall required&#xa;Citations must occur in tool results&#xa;Answer + visual schema validated" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="650" y="565" width="260" height="140" as="geometry"/></mxCell><mxCell id="response" value="FastAPI response&#xa;{session_id, answer, citations, visual, tool_calls}&#xa;Log assistant turn • release session lock&#xa;502/504 on upstream or validation failure" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="335" y="565" width="260" height="140" as="geometry"/></mxCell><mxCell id="render" value="Frontend validation + rendering&#xa;Zod contract • Markdown (HTML off)&#xa;Exact citation chips + six typed visuals&#xa;Accessible pending/error states" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="35" y="565" width="245" height="140" as="geometry"/></mxCell><mxCell id="e1" value="JSON request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="request" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="authorize / reserve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="mapping"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="bound session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mapping" target="bridge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="trusted prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bridge" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="tool call loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="agent" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="read tools" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mcp" target="reads"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="read-only query / doc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reads" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="rows + report text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="db" target="reads"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reads" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="if user feedback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="agent" target="writes"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="audited insert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="writes" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="echo affected view" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="writes" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="final JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="agent" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="verified result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="validate" target="response"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="HTTP 200 JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="response" target="render"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="follow-up; same session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;endArrow=classic;endFill=1;strokeColor=#526579;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="render" target="request"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="trustedTitle" value="TRUST / SAFETY CONTROLS" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="38" y="755" width="400" height="28" as="geometry"/></mxCell><mxCell id="trust1" value="Identity boundary&#xa;This is a local/trusted demo, NOT authenticated. user_id is caller-supplied. Session ownership + MCP metadata bind API-created conversations, but do not defend against a malicious local process." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="35" y="800" width="420" height="125" as="geometry"/></mxCell><mxCell id="trust2" value="Read boundary&#xa;query_db permits one read-only SELECT/WITH/EXPLAIN, capped at 50 rows. Private memories/messages/sessions are blocked from arbitrary SQL. Production, downtime, spill/SOP/RCA logic belongs in v_* views." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="485" y="800" width="420" height="125" as="geometry"/></mxCell><mxCell id="trust3" value="Write boundary&#xa;Corrections are audited overlays; rules are explicit runtime overrides; facts are shared; claims remain unconfirmed; memories are per-user. No raw inspection row is changed. Timeout can happen after a write committed." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="935" y="800" width="420" height="125" as="geometry"/></mxCell><mxCell id="trust4" value="Failure boundary&#xa;No streaming or simulated progress. 403/404/409/422/502/503/504 are surfaced; no answer is shown unless tool evidence, recall, citations and shape pass validation. Never auto-retry uncertain writes." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="1385" y="800" width="420" height="125" as="geometry"/></mxCell><mxCell id="asof" value="Evaluation date = meta.as_of_&lt;dataset&gt;; never substitute wall-clock date. Run one API deployment per database. Add authentication/authorization before any public exposure." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="38" y="952" width="1750" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
