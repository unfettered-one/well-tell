# Uses the GitHub Copilot account already connected through OpenCode /connect.
# OpenCode free models can be selected here if your account permits them.
OPENCODE_MODEL=github-copilot/gpt-6.1-sol#low
OPENCODE_BIN=opencode
WELL_COPILOT_DB=data/well_copilot.db
COPILOT_TIMEOUT=300
# Optional: an explicitly configured OpenCode server (CLI handles credentials).
# OPENCODE_SERVER=http://127.0.0.1:4096
